{
  "name": "@edutrack/web",
  "version": "1.0.0",
  "private": true,
  "description": "EduTrack Pro web application (Next.js App Router)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:build": "next build",
    "e2e:serve": "next build && next start -p 4100 -H 127.0.0.1"
  },
  "dependencies": {
    "@edutrack/shared-config": "*",
    "@edutrack/shared-types": "*",
    "@edutrack/validation": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
