{
  "name": "@edutrack/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "EduTrack Pro mobile app (Expo / React Native) for teachers and guardians.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-image-picker": "~15.0.7",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "typescript": "^5.4.5"
  }
}