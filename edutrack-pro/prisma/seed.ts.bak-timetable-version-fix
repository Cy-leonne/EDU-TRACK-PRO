  log(`Teachers: ${teacherUsers.length} (first teacher login: ${primaryTeacherEmail})`);

  /* ------------------------- 5. classes & learners ----------------------- */
  const classPlan = [
    { name: 'Grade 7 Tumaini', grade: 7, stream: 'Tumaini', room: 'R7A', classTeacher: 0 },
    { name: 'Grade 7 Baraka', grade: 7, stream: 'Baraka', room: 'R7B', classTeacher: 1 },
    { name: 'Grade 8 Imani', grade: 8, stream: 'Imani', room: 'R8A', classTeacher: 2 },
    { name: 'Grade 8 Neema', grade: 8, stream: 'Neema', room: 'R8B', classTeacher: 3 },
    { name: 'Grade 9 Amani', grade: 9, stream: 'Amani', room: 'R9A', classTeacher: 4 },
  ];
  const classes: { id: string; name: string; grade: number }[] = [];
  for (const plan of classPlan) {
    const grade = grades.find((g) => g.level === plan.grade)!;
    const row = await prisma.class.create({
      data: {
        schoolId: school.id, academicYearId: academicYear.id, gradeId: grade.id, name: plan.name, stream: plan.stream,
        classTeacherId: teacherProfiles.get(teacherPlanKeys[plan.classTeacher]!) ?? null,
        roomId: rooms.get(plan.room) ?? null, capacity: 45,
