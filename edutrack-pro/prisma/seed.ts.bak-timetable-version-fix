/* ------------------------------- the seeding ------------------------------ */

async function main(): Promise<void> {
  // Demo seeding must never happen on a production database by accident.
  // `npm run db:seed` is a manual local-development step; this guard stops it
  // from being wired into a deploy pipeline. Override deliberately with
  // ALLOW_DEMO_SEED=true when you really do want the sample school.
  if (process.env.NODE_ENV === 'production' && process.env.ALLOW_DEMO_SEED !== 'true') {
    process.stderr.write(
      '\nRefusing to seed demo data with NODE_ENV=production.\n' +
        'Production installs use POST /api/v1/auth/setup/first-admin (INITIAL_ADMIN_SETUP_TOKEN)\n' +
        'or `npm run setup:admin`, never the demo seed.\n' +
        'Set ALLOW_DEMO_SEED=true only if you deliberately want the demo school.\n\n',
    );
    process.exitCode = 1;
    return;
  }

  process.stdout.write('\nEduTrack Pro seed\n===================\n');

  const adminEmail = process.env.SEED_ADMIN_EMAIL ?? 'admin@nhjs.demo';
  const teacherEmail = process.env.SEED_TEACHER_EMAIL ?? 'teacher@nhjs.demo';
  const parentEmail = process.env.SEED_PARENT_EMAIL ?? 'parent@nhjs.demo';
  const adminPassword = process.env.SEED_ADMIN_PASSWORD ?? randomPassword();
  const staffPassword = process.env.SEED_TEACHER_PASSWORD ?? randomPassword();
  const parentPassword = process.env.SEED_PARENT_PASSWORD ?? randomPassword();
  const generatedPasswords = {
    admin: !process.env.SEED_ADMIN_PASSWORD,
    teacher: !process.env.SEED_TEACHER_PASSWORD,
    parent: !process.env.SEED_PARENT_PASSWORD,
  };

  const existing = await prisma.school.findUnique({ where: { code: SCHOOL_CODE } });
  if (existing && KEEP) {
    log(`Demo school ${SCHOOL_CODE} already exists — nothing to do (--keep).`);
    return;
  }
  if (existing) {
    log(`Removing previous demo school ${existing.name} (${existing.id}) …`);
    // Deleting the school cascades its classes, learners, links, files, timetables and results.
    await prisma.school.delete({ where: { id: existing.id } });
    // Accounts created by an earlier seed run are removed so emails can be reused.
    await prisma.user.deleteMany({
      where: {
        OR: [
          { email: { endsWith: '@nhjs.demo' } },
          { email: { in: [adminEmail, teacherEmail, parentEmail] } },
        ],
        memberships: { none: {} },
      },
    });
    // Users from a previous run may still hold memberships in a school that was removed manually.
    await prisma.user.deleteMany({ where: { email: { endsWith: '@nhjs.demo' }, memberships: { none: {} } } });
  }

  /* ------------------------------ 1. school ------------------------------ */
  const school = await prisma.school.create({
    data: {
      name: 'Nakuru Hills Junior School (Demo)',
      code: SCHOOL_CODE,
      addressLine: 'Off Kenyatta Avenue, Milimani',
      county: 'Nakuru',
      phone: '+254700000001',
      email: 'office@nhjs.demo',
      website: 'https://nhjs.demo',
      motto: 'Competence for life',
      timezone: 'Africa/Nairobi',
      currency: 'KES',
      portalName: 'Nakuru Hills Junior School',
      primaryColor: '#12304A',
      accentColor: '#0F766E',
      workingDays: [1, 2, 3, 4, 5],
      schoolOpenTime: '07:30',
      schoolCloseTime: '16:30',
      defaultPeriodMinutes: 40,
      maxPeriodsPerDay: 8,
      breakConfig: [{ label: 'Short break', afterPeriod: 2, minutes: 20 }],
      lunchConfig: { label: 'Lunch', afterPeriod: 5, minutes: 40 },
      settings: {
        // Everything below is head-teacher configurable; none of it is a national rule.
        internalAssessmentNote: 'Internal school records only. These are not official KNEC/KICD outcomes.',
        achievementBandsAreSchoolDefined: true,
        allowParentSelfLink: true,
      } as Prisma.InputJsonValue,
    },
  });
  log(`School created: ${school.name} (${school.id})`);

  const academicYear = await prisma.academicYear.create({
    data: { schoolId: school.id, name: '2026', startDate: new Date('2026-01-05'), endDate: new Date('2026-10-30'), isCurrent: true },
  });
  const terms = await Promise.all([
    prisma.term.create({ data: { schoolId: school.id, academicYearId: academicYear.id, number: 1, name: 'Term 1', startDate: new Date('2026-01-05'), endDate: new Date('2026-04-03') } }),
    prisma.term.create({ data: { schoolId: school.id, academicYearId: academicYear.id, number: 2, name: 'Term 2', startDate: new Date('2026-05-04'), endDate: new Date('2026-08-07') } }),
    prisma.term.create({ data: { schoolId: school.id, academicYearId: academicYear.id, number: 3, name: 'Term 3', startDate: new Date('2026-09-01'), endDate: new Date('2026-10-30'), isCurrent: true } }),
  ]);
  const currentTerm = terms[2]!;
  await prisma.school.update({ where: { id: school.id }, data: { currentAcademicYearId: academicYear.id, currentTermId: currentTerm.id } });
  const grades = await Promise.all([7, 8, 9].map((level, index) =>
    prisma.grade.create({ data: { schoolId: school.id, level, name: `Grade ${level}`, order: index } })));
