    });
    classes.push({ id: row.id, name: row.name, grade: plan.grade });
  }

  const learners: { id: string; name: string; classId: string; assessmentNumber: string }[] = [];
  let admission = 1;
  for (const klass of classes) {
    for (let index = 0; index < 24; index += 1) {
      const female = rng() > 0.5;
      const first = female ? pick(FIRST_NAMES_F) : pick(FIRST_NAMES_M);
      const last = pick(SURNAMES);
      const admissionNumber = `NHJS/${2026}/${String(admission).padStart(4, '0')}`;
      const assessmentNumber = `${klass.grade}${String(admission).padStart(5, '0')}`;
      const learner = await prisma.learner.create({
        data: {
          schoolId: school.id, admissionNumber, assessmentNumber, upiNumber: `UPI${between(100_000_000, 999_999_999)}`,
          firstName: first, lastName: last, gender: female ? 'FEMALE' : 'MALE',
          dateOfBirth: new Date(Date.UTC(2012 + (9 - klass.grade), between(0, 11), between(1, 28))),
          gradeId: grades.find((g) => g.level === klass.grade)!.id, currentClassId: klass.id,
          status: 'ACTIVE', enrolledOn: new Date('2026-01-05'), homeLocation: pick(KENYAN_TOWNS),
        },
      });
      await prisma.classEnrollment.create({
        data: { schoolId: school.id, learnerId: learner.id, classId: klass.id, academicYearId: academicYear.id, termId: terms[0]!.id, enrolledAt: new Date('2026-01-05'), createdById: admin.id, status: 'ACTIVE' },
      });
      learners.push({ id: learner.id, name: `${first} ${last}`, classId: klass.id, assessmentNumber });
      admission += 1;
    }
  }
  log(`Classes: ${classes.length} · learners: ${learners.length} (synthetic names only)`);

  /* ------------------------ 6. parents & verified links ------------------- */
  const parentPlan = [
    { email: parentEmail, name: 'Mary Achieng (Demo Parent)', relationship: 'Mother', children: 3 },
    { email: 'peter.kimani@nhjs.demo', name: 'Peter Kimani', relationship: 'Father', children: 2 },
    { email: 'zainab.abdi@nhjs.demo', name: 'Zainab Abdi', relationship: 'Mother', children: 1 },
    { email: 'joseph.otieno@nhjs.demo', name: 'Joseph Otieno', relationship: 'Guardian', children: 2 },
    { email: 'esther.chepkoech@nhjs.demo', name: 'Esther Chepkoech', relationship: 'Mother', children: 1 },
  ];
  const parents: { id: string; userId: string; name: string; email: string }[] = [];
  for (const parent of parentPlan) {
    const user = await prisma.user.create({
      data: {
        email: parent.email, passwordHash: await hashPassword(parentPassword), fullName: parent.name,
        phone: `+2547${between(10_000_000, 99_999_999)}`,
        memberships: { create: { schoolId: school.id, role: 'PARENT', status: 'ACTIVE' } },
      },
    });
    const profile = await prisma.parentProfile.create({
      data: {
        userId: user.id, schoolId: school.id, phone: `+2547${between(10_000_000, 99_999_999)}`,
        relationship: parent.relationship, occupation: pick(['Farmer', 'Teacher', 'Trader', 'Nurse', 'Driver', 'Engineer']),
        addressLine: `P.O. Box ${between(100, 9999)}, ${pick(KENYAN_TOWNS)}`,
      },
    });
    parents.push({ id: profile.id, userId: user.id, name: parent.name, email: parent.email });
  }

  let linkCount = 0;
  for (const [index, parent] of parents.entries()) {
    const plan = parentPlan[index]!;
    for (let child = 0; child < plan.children; child += 1) {
      const learner = learners[(index * 7 + child * 5) % learners.length]!;
      const alreadyLinked = await prisma.parentLearnerLink.findFirst({ where: { parentProfileId: parent.id, learnerId: learner.id } });
      if (alreadyLinked) continue;
      await prisma.parentLearnerLink.create({
        data: {
          schoolId: school.id, parentProfileId: parent.id, learnerId: learner.id, relationship: plan.relationship,
          isPrimaryContact: child === 0, isVerified: true, verificationMethod: 'ADMIN_RECORD',
          verifiedAt: new Date('2026-02-02T09:00:00Z'), verifiedById: admin.id, canViewResults: true, canViewResources: true,
          notes: 'Verified by the school office against the admission register (demo data).',
        },
      });
      linkCount += 1;
    }
  }
  // One deliberately unverified link so the admin UI has a pending verification to show.
  const pendingLearner = learners.find((l) => !l.name.includes('')) ?? learners[0]!;
  const pendingParent = parents[parents.length - 1]!;
  const unverified = await prisma.parentLearnerLink.findFirst({ where: { parentProfileId: pendingParent.id, learnerId: pendingLearner.id } });
  if (unverified) {
    await prisma.parentLearnerLink.update({ where: { id: unverified.id }, data: { isVerified: false, verificationMethod: null, verifiedAt: null, verifiedById: null } });
  } else {
    await prisma.parentLearnerLink.create({
      data: { schoolId: school.id, parentProfileId: pendingParent.id, learnerId: pendingLearner.id, relationship: 'Guardian', isVerified: false, notes: 'Self-requested link awaiting office verification (demo).' },
    });
  }
  log(`Parents: ${parents.length} · verified learner links: ${linkCount} (+1 pending verification)`);

  /* --------------------- 7. weekly requirements & assignments ------------- */
  for (const klass of classes) {
    for (const area of LEARNING_AREAS) {
      await prisma.classLearningAreaRequirement.create({
        data: {
          schoolId: school.id, classId: klass.id, learningAreaId: learningAreas.get(area.code)!,
          periodsPerWeek: area.periods, preferMorning: area.preferMorning,
          requiredRoomId: area.code === 'SCI' ? rooms.get('LAB') ?? null : area.code === 'PTS' ? rooms.get('WSH') ?? null : null,
        },
      });
    }
  }

  /** Which teacher takes which learning area for which class. Totals stay inside the school workload cap. */
  const assignmentPlan: { planKey: string; area: string; classIndexes: number[] }[] = [
    { planKey: 'MAT', area: 'MAT', classIndexes: [0, 1, 2, 3, 4] },
    { planKey: 'ENG', area: 'ENG', classIndexes: [0, 1, 2, 3, 4] },
    { planKey: 'KIS', area: 'KIS', classIndexes: [0, 1, 2, 3, 4] },
    { planKey: 'SCI', area: 'SCI', classIndexes: [0, 1, 2, 3, 4] },
    { planKey: 'PTSAGR', area: 'PTS', classIndexes: [0, 1, 2, 3, 4] },
    { planKey: 'SSTCRE', area: 'SST', classIndexes: [0, 1, 2] },
    { planKey: 'SSTCRE2', area: 'SST', classIndexes: [3, 4] },
    { planKey: 'SSTCRE', area: 'CRE', classIndexes: [3, 4] },
    { planKey: 'SSTCRE2', area: 'CRE', classIndexes: [0, 1, 2] },
    { planKey: 'PTSAGR', area: 'AGR', classIndexes: [0, 1, 2] },
    { planKey: 'CASAGR', area: 'AGR', classIndexes: [3, 4] },
    { planKey: 'CASAGR', area: 'CAS', classIndexes: [0, 1, 2, 3, 4] },
  ];
  const assignmentIds = new Map<string, string>();
  for (const plan of assignmentPlan) {
    const teacherId = teacherProfiles.get(plan.planKey)!;
    for (const classIndex of plan.classIndexes) {
      const klass = classes[classIndex]!;
      const created = await prisma.teacherAssignment.create({
        data: { schoolId: school.id, teacherId, classId: klass.id, learningAreaId: learningAreas.get(plan.area)!, isPrimary: true },
      });
      assignmentIds.set(`${klass.id}|${plan.area}`, created.id);
    }
  }
  log(`Weekly requirements: ${classes.length * LEARNING_AREAS.length} rows · teaching assignments: ${assignmentIds.size}`);

  /* ------------- 8. assessment categories, bands, rubric, content ---------- */
  const categories = new Map<string, string>();
  for (const [order, category] of ASSESSMENT_CATEGORIES.entries()) {
    const row = await prisma.assessmentCategory.create({
      data: {
        schoolId: school.id, code: category.code, name: category.name, description: category.description, order,
        allowsMarks: true, allowsRubric: true, defaultMaxMarks: category.code === 'QUIZ' ? 20 : category.code === 'CAT' ? 30 : 50,
        defaultWeight: null, // the school sets weights explicitly — the platform invents none
      },
    });
    categories.set(category.code, row.id);
  }
  const bands = new Map<string, string>();
  for (const band of ACHIEVEMENT_LEVELS) {
    const row = await prisma.achievementLevel.create({
      data: {
        schoolId: school.id, label: band.name, code: band.code, minPercent: band.minPercent, maxPercent: band.maxPercent,
        order: band.order, description: `${band.description} (school-defined band, configurable in Admin → Assessments)`,
      },
    });
    bands.set(band.code, row.id);
  }
  // Deterministic, obviously-internal assignment of a band to a percentage.
  const bandFor = (percent: number): string => (percent >= 80 ? bands.get('EE')! : percent >= 60 ? bands.get('ME')! : percent >= 40 ? bands.get('AE')! : bands.get('BE')!);

  const matArea = learningAreas.get('MAT')!;
  const rubric = await prisma.rubric.create({
    data: {
      schoolId: school.id, learningAreaId: matArea, title: 'Mathematics project rubric (school template)',
      description: 'Four criteria used for the school project assessment. Levels are school-defined.',
      createdById: admin.id,
      criteria: {
        create: [
          { title: 'Understanding of concepts', description: 'Correct use of the topic being assessed', maxScore: 10, order: 0 },
          { title: 'Working and reasoning', description: 'Clear, logical steps shown', maxScore: 10, order: 1 },
          { title: 'Accuracy', description: 'Correct final answers', maxScore: 10, order: 2 },
          { title: 'Presentation and neatness', description: 'Organised, legible work', maxScore: 10, order: 3 },
        ],
      },
    },
  });

  const strandRows = await prisma.strand.findMany({ where: { schoolId: school.id }, include: { subStrands: true } });
  const strandFor = (areaCode: string) => strandRows.find((s) => s.learningAreaId === learningAreas.get(areaCode)) ?? null;

  const publishedAssessments: { id: string; classId: string; areaCode: string; total: number; title: string }[] = [];
  const draftAssessments: { id: string; classId: string; areaCode: string }[] = [];
  let assessmentCount = 0;
  for (const klass of classes) {
    const rows: { areaCode: string; title: string; category: string; offsetDays: number; total: number; status: 'PUBLISHED' | 'DRAFT' | 'READY_FOR_REVIEW' }[] = [
      { areaCode: 'MAT', title: 'Numbers and algebra CAT', category: 'CAT', offsetDays: -35, total: 30, status: 'PUBLISHED' },
      { areaCode: 'ENG', title: 'Reading comprehension CAT', category: 'CAT', offsetDays: -30, total: 30, status: 'PUBLISHED' },
      { areaCode: 'SCI', title: 'Matter and mixtures practical', category: 'PRACTICAL', offsetDays: -18, total: 20, status: 'PUBLISHED' },
      { areaCode: 'MAT', title: 'Data handling project', category: 'PROJECT', offsetDays: -10, total: 40, status: 'PUBLISHED' },
      { areaCode: 'KIS', title: 'Insha ya masimulizi', category: 'ASSIGNMENT', offsetDays: -4, total: 20, status: 'READY_FOR_REVIEW' },
      { areaCode: 'SST', title: 'Population and devolution test', category: 'TEST', offsetDays: 6, total: 30, status: 'DRAFT' },
    ];
    for (const row of rows) {
      const areaId = learningAreas.get(row.areaCode)!;
      const strand = strandFor(row.areaCode);
      const assessmentDate = new Date(Date.UTC(2026, 8, 1) + row.offsetDays * 86_400_000);
      const created = await prisma.assessment.create({
        data: {
          schoolId: school.id, academicYearId: academicYear.id, termId: currentTerm.id, classId: klass.id,
          learningAreaId: areaId, categoryId: categories.get(row.category)!,
          strandId: strand?.id ?? null, subStrandId: strand?.subStrands[0]?.id ?? null,
          rubricId: row.category === 'PROJECT' && row.areaCode === 'MAT' ? rubric.id : null,
          createdById: admin.id,
          title: `${row.title} — ${klass.name}`,
          description: `School ${row.category.toLowerCase()} assessment for ${klass.name}. Recorded against school-defined bands only.`,
          instructions: 'Attempt all questions. Show your working clearly.',
          assessmentDate, dueDate: new Date(assessmentDate.getTime() + 7 * 86_400_000),
          totalMarks: row.total, usesMarks: true, usesRubric: row.category === 'PROJECT', isExternallyReported: false,
          status: row.status,
          publishedAt: row.status === 'PUBLISHED' ? new Date(assessmentDate.getTime() + 4 * 86_400_000) : null,
          publishedById: row.status === 'PUBLISHED' ? admin.id : null,
        },
      });
      assessmentCount += 1;
      if (row.status === 'PUBLISHED') publishedAssessments.push({ id: created.id, classId: klass.id, areaCode: row.areaCode, total: row.total, title: created.title });
      if (row.status !== 'PUBLISHED') draftAssessments.push({ id: created.id, classId: klass.id, areaCode: row.areaCode });
    }
  }
  log(`Assessments: ${assessmentCount} (${publishedAssessments.length} published, ${draftAssessments.length} in progress)`);

  /* --------------------------- 9. results & feedback --------------------- */
  let resultCount = 0;
  let amended = 0;
  for (const assessment of publishedAssessments) {
    const classLearners = learners.filter((l) => l.classId === assessment.classId);
    let teacherId = (await prisma.teacherAssignment.findFirst({ where: { classId: assessment.classId, learningAreaId: learningAreas.get(assessment.areaCode)! } }))?.teacherId;
    if (!teacherId) teacherId = teacherProfiles.get('MAT')!;
    const entryUser = (await prisma.teacherProfile.findUnique({ where: { id: teacherId } }))?.userId ?? admin.id;
    for (const learner of classLearners) {
      const percent = between(28, 96);
      const score = Math.round((percent / 100) * assessment.total * 2) / 2;
      const isAbsent = rng() < 0.02;
      const result = await prisma.assessmentResult.create({
        data: {
          schoolId: school.id, assessmentId: assessment.id, learnerId: learner.id,
          numericScore: isAbsent ? null : score, achievementLevelId: isAbsent ? null : bandFor((score / assessment.total) * 100),
          isAbsent, status: 'PUBLISHED', enteredById: entryUser, publishedById: entryUser,
          publishedAt: new Date(Date.UTC(2026, 8, 20)), comment: isAbsent ? 'Absent for this assessment' : null,
        },
      });
      await prisma.resultChangeLog.create({
        data: { resultId: result.id, actorId: entryUser, action: 'PUBLISH', reason: 'Published with the assessment', afterJson: { numericScore: score, status: 'PUBLISHED' } as Prisma.InputJsonValue },
      });
      resultCount += 1;

      // Narrative feedback on a subset (the teacher writes these in the app).
      if (rng() < 0.35) {
        await prisma.resultFeedback.create({
          data: {
            resultId: result.id, authorId: entryUser, isPublished: true,
            narrative: percent >= 80
              ? 'Consistent and confident work. Try the extension questions next.'
              : percent >= 60
                ? 'Solid understanding. Watch the small calculation slips we discussed in class.'
                : percent >= 40
                  ? 'Approaching the expected level. Please revise the worked examples in the notes and come for support on Tuesday.'
                  : 'Needs targeted support. I will work with this learner in a small group this week and share practice activities.',
          },
        });
      }
      // One amended result per published assessment, with an immutable change trail.
      if (rng() < 1 / classLearners.length) {
        const corrected = Math.min(assessment.total, score + between(1, 3));
        await prisma.assessmentResult.update({
          where: { id: result.id },
          data: { numericScore: corrected, achievementLevelId: bandFor((corrected / assessment.total) * 100), status: 'AMENDED', amendedAt: new Date(Date.UTC(2026, 8, 24)) },
        });
        await prisma.resultChangeLog.create({
          data: {
            resultId: result.id, actorId: entryUser, action: 'AMEND', reason: 'Marks addition error spotted during moderation.',
            beforeJson: { numericScore: score, status: 'PUBLISHED' } as Prisma.InputJsonValue,
            afterJson: { numericScore: corrected, status: 'AMENDED' } as Prisma.InputJsonValue,
          },
        });
        amended += 1;
      }
    }
  }
  // Draft results on the "ready for review" assessments so the teacher grid is not empty.
  for (const assessment of draftAssessments.filter((a) => a.areaCode === 'KIS')) {
    const classLearners = learners.filter((l) => l.classId === assessment.classId);
    const assignment = await prisma.teacherAssignment.findFirst({ where: { classId: assessment.classId, learningAreaId: learningAreas.get('KIS')! } });
    const entryUser = (await prisma.teacherProfile.findUnique({ where: { id: assignment?.teacherId ?? teacherProfiles.get('KIS')! } }))?.userId ?? admin.id;
    for (const learner of classLearners.slice(0, 18)) {
      const score = between(8, 20);
      await prisma.assessmentResult.create({
        data: { schoolId: school.id, assessmentId: assessment.id, learnerId: learner.id, numericScore: score, achievementLevelId: bandFor((score / 20) * 100), status: 'DRAFT', enteredById: entryUser },
      });
      resultCount += 1;
    }
  }
  log(`Results: ${resultCount} (${amended} amended with a change trail) · feedback written on ~35%`);

  /* ------------------------ 10. resources & assignments ------------------ */
  const primaryParent = parents[0]!;
  const parentLinks = await prisma.parentLearnerLink.findMany({ where: { parentProfileId: primaryParent.id, isVerified: true } });
  const parentClassIds = new Set(parentLinks.map((l) => learners.find((x) => x.id === l.learnerId)?.classId).filter(Boolean) as string[]);

  let resourceCount = 0;
  let assignmentCount = 0;
  for (const klass of classes) {
    const file = await storeFile(
      school.id, 'RESOURCE',
      `${klass.name.replace(/\s+/g, '-').toLowerCase()}-notes-pack.pdf`,
      minimalPdf([
        `${klass.name} — Learning notes pack (demo document)`,
        '',
        'This PDF was generated by prisma/seed.ts to demonstrate private file upload,',
        'authorised download and parent visibility in EduTrack Pro.',
        '',
        'It contains no real learner data.',
        `School: ${school.name}`,
      ]),
      admin.id,
    );
    const matClassArea = learningAreas.get('MAT')!;
    const primaryTeacherUserId = (await prisma.teacherAssignment.findFirst({ where: { classId: klass.id, learningAreaId: matClassArea } }))?.teacherId;
    const resourceAuthor = (primaryTeacherUserId && (await prisma.teacherProfile.findUnique({ where: { id: primaryTeacherUserId } }))?.userId) || admin.id;

    const fileResource = await prisma.learningResource.create({
      data: {
        schoolId: school.id, classId: klass.id, learningAreaId: matClassArea, createdById: resourceAuthor, fileId: file.id,
        type: 'FILE', title: `${klass.name} mathematics notes pack (PDF)`, description: 'Printable notes covering the term strands.',
        body: 'Download, print and file in your mathematics notebook. Bring it to every lesson.',
        visibleToParents: true, publishedAt: new Date(Date.UTC(2026, 8, 8)),
      },
    });
    resourceCount += 1;

    const engResource = await prisma.learningResource.create({
      data: {
        schoolId: school.id, classId: klass.id, learningAreaId: learningAreas.get('ENG')!, createdById: resourceAuthor,
        type: 'NOTE', title: 'Reading comprehension strategies', visibleToParents: true, publishedAt: new Date(Date.UTC(2026, 8, 10)),
        body: 'Skim, scan, then read closely.\n1. Underline the question words.\n2. Find the paragraph that answers it.\n3. Answer in a full sentence where the question asks you to explain.',
      },
    });
    resourceCount += 1;

    const sciResource = await prisma.learningResource.create({
      data: {
        schoolId: school.id, classId: klass.id, learningAreaId: learningAreas.get('SCI')!, createdById: resourceAuthor,
        type: 'LINK', title: 'Kitchen-science: mixtures at home', externalUrl: 'https://example.org/junior-school/mixtures',
        visibleToParents: true, publishedAt: new Date(Date.UTC(2026, 8, 12)),
        description: 'Safe, no-cost experiments using materials found at home. Example link for demo purposes.',
      },
    });
    resourceCount += 1;

    await prisma.assignment.create({
      data: {
        schoolId: school.id, classId: klass.id, learningAreaId: learningAreas.get('MAT')!, resourceId: fileResource.id, createdById: resourceAuthor,
        title: 'Notes pack exercises 1–10', instructions: 'Complete exercises 1 to 10 in the notes pack and show all working.',
        dueDate: new Date(Date.UTC(2026, 9, 5)), maxScore: 20, publishedAt: new Date(Date.UTC(2026, 8, 15)),
      },
    });
    await prisma.assignment.create({
      data: {
        schoolId: school.id, classId: klass.id, learningAreaId: learningAreas.get('ENG')!, resourceId: engResource.id, createdById: resourceAuthor,
        title: 'Comprehension practice: three short passages', instructions: 'Use the strategy notes, then write one-sentence answers.',
        dueDate: new Date(Date.UTC(2026, 9, 9)), maxScore: 15, publishedAt: new Date(Date.UTC(2026, 8, 18)),
      },
    });
    resourceCount += 0;
    assignmentCount += 2;

    // Attach a real PDF to one published assessment per class.
    const publishedForClass = publishedAssessments.find((a) => a.classId === klass.id);
    if (publishedForClass) {
      const attachment = await storeFile(
        school.id, 'ASSESSMENT', `${klass.name.replace(/\s+/g, '-').toLowerCase()}-question-paper.pdf`,
        minimalPdf(['Question paper (demo)', '', `Assessment: ${publishedForClass.title}`, '', 'Section A: answer all questions.']),
        resourceAuthor,
      );
      await prisma.assessmentResource.create({
        data: { assessmentId: publishedForClass.id, fileId: attachment.id, title: 'Question paper (PDF)', kind: 'DOCUMENT' },
      });
    }
  }
  log(`Learning resources: ${resourceCount} · assignments: ${assignmentCount} · ${classes.length} private PDFs stored under ./storage`);
  log(`Primary parent ${primaryParent.email} is linked to learners in ${parentClassIds.size} class(es)`);

  /* ---------------------- 11. bell schedule (period grid) ----------------- */
  const grid: { label: string; minutes: number; kind: 'TEACHING' | 'BREAK' | 'LUNCH' }[] = [
    { label: 'Period 1', minutes: 40, kind: 'TEACHING' },
    { label: 'Period 2', minutes: 40, kind: 'TEACHING' },
    { label: 'Short break', minutes: 20, kind: 'BREAK' },
    { label: 'Period 3', minutes: 40, kind: 'TEACHING' },
    { label: 'Period 4', minutes: 40, kind: 'TEACHING' },
    { label: 'Period 5', minutes: 40, kind: 'TEACHING' },
    { label: 'Lunch', minutes: 40, kind: 'LUNCH' },
    { label: 'Period 6', minutes: 40, kind: 'TEACHING' },
    { label: 'Period 7', minutes: 40, kind: 'TEACHING' },
    { label: 'Period 8', minutes: 40, kind: 'TEACHING' },
  ];
  const toMinutes = (hhmm: string) => Number(hhmm.slice(0, 2)) * 60 + Number(hhmm.slice(3, 5));
  const toClock = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
  const periodRows: { id: string; dayOfWeek: number; sequence: number; label: string; startTime: string; endTime: string; isTeaching: boolean; isBreak: boolean; isLunch: boolean }[] = [];
  for (const day of school.workingDays) {
    let cursor = toMinutes(school.schoolOpenTime);
    for (const [index, slot] of grid.entries()) {
      const startTime = toClock(cursor);
      cursor += slot.minutes;
      const endTime = toClock(cursor);
      const row = await prisma.timetablePeriod.create({
        data: {
          schoolId: school.id, academicYearId: academicYear.id, termId: currentTerm.id, dayOfWeek: day,
          sequence: index + 1, label: slot.label, startTime, endTime,
          isBreak: slot.kind === 'BREAK', isLunch: slot.kind === 'LUNCH', isTeaching: slot.kind === 'TEACHING',
        },
      });
      periodRows.push({ id: row.id, dayOfWeek: day, sequence: index + 1, label: row.label, startTime, endTime, isTeaching: row.isTeaching, isBreak: row.isBreak, isLunch: row.isLunch });
    }
  }
  log(`Bell schedule: ${periodRows.length} slots (${periodRows.filter((p) => p.isTeaching).length} teaching periods across ${school.workingDays.length} days)`);

  /* ------------------ 12. generate + validate + publish timetable --------- */
  const requirements = await prisma.classLearningAreaRequirement.findMany({ where: { schoolId: school.id }, include: { learningArea: true } });
  const assignmentRows = await prisma.teacherAssignment.findMany({ where: { schoolId: school.id, isActive: true } });
  const teacherRows = await prisma.teacherProfile.findMany({ where: { schoolId: school.id }, include: { availability: true, user: true } });
  const roomRows = await prisma.room.findMany({ where: { schoolId: school.id } });

  const generatorConfig: GeneratorConfig = {
    seed: SCHEDULING_DEFAULTS.randomTieBreakSeedDefault,
    maxConsecutiveSameArea: SCHEDULING_DEFAULTS.maxConsecutivePeriodsPerLearningArea,
    maxConsecutiveTeacherPeriods: SCHEDULING_DEFAULTS.maxConsecutivePeriodsPerTeacher,
    maxPeriodsPerDayPerClass: Math.min(SCHEDULING_DEFAULTS.maxPeriodsPerDayPerClass, school.maxPeriodsPerDay),
    respectTeacherFreeDays: true,
    useRooms: false,
    balanceDailyLoad: true,
    avoidTeacherGaps: true,
    preferDoubleLessons: false,
    teacherGapPenalty: SCHEDULING_DEFAULTS.teacherGapPenalty,
    classGapPenalty: SCHEDULING_DEFAULTS.classGapPenalty,
    sameSubjectSameDayPenalty: SCHEDULING_DEFAULTS.sameSubjectSameDayPenalty,
    consecutiveSameSubjectPenalty: SCHEDULING_DEFAULTS.consecutiveSameSubjectPenalty,
    teacherConsecutivePenalty: SCHEDULING_DEFAULTS.teacherConsecutivePenalty,
    balanceDailyLoadPenalty: SCHEDULING_DEFAULTS.balanceDailyLoadPenalty,
    moveStabilityBonus: SCHEDULING_DEFAULTS.moveStabilityBonus,
    timeBudgetMs: 8000,
  };

  const generator = new TimetableGenerator({
    periods: periodRows.map((p) => ({ id: p.id, dayOfWeek: p.dayOfWeek, sequence: p.sequence, startTime: p.startTime, endTime: p.endTime, isTeaching: p.isTeaching, isBreak: p.isBreak, isLunch: p.isLunch })),
    requirements: requirements.map((r) => ({
      classId: r.classId, className: classes.find((c) => c.id === r.classId)?.name ?? r.classId,
      learningAreaId: r.learningAreaId, learningAreaName: r.learningArea.name, periodsPerWeek: r.periodsPerWeek,
      preferDoubleLesson: r.preferDoubleLesson, preferMorning: r.preferMorning, requiredRoomId: r.requiredRoomId,
    })),
    assignments: assignmentRows.map((a) => ({ classId: a.classId, learningAreaId: a.learningAreaId, teacherId: a.teacherId, teacherName: teacherRows.find((t) => t.id === a.teacherId)?.user.fullName ?? '' })),
    teachers: teacherRows.map((t) => ({
      id: t.id, name: t.user.fullName, maxPeriodsPerDay: t.maxPeriodsPerDay, maxPeriodsPerWeek: t.maxPeriodsPerWeek,
      prefersFreeDays: t.prefersFreeDays,
      unavailable: t.availability.filter((a) => !a.isAvailable).map((a) => ({ dayOfWeek: a.dayOfWeek, periodIndex: a.periodIndex })),
      assignments: assignmentRows.filter((a) => a.teacherId === t.id).map((a) => ({ classId: a.classId, learningAreaId: a.learningAreaId })),
    })),
    rooms: [],
    config: generatorConfig,
  });
  const schedule = generator.run();

  const timetable = await prisma.timetable.create({
    data: {
      schoolId: school.id, academicYearId: academicYear.id, termId: currentTerm.id,
      name: `Term 3 2026 — whole school`, description: 'Generated by the built-in scheduling engine during seeding, then validated and published.',
      scope: 'WHOLE_SCHOOL', status: 'PUBLISHED', createdById: admin.id, config: generatorConfig as unknown as Prisma.InputJsonValue,
    },
  });
  const version = await prisma.timetableVersion.create({
    data: {
      timetableId: timetable.id, schoolId: school.id, versionNumber: 1, status: 'PUBLISHED', isCurrent: true,
      notes: `Generated by prisma/seed.ts (engine seed ${generatorConfig.seed})`,
      generatedAt: new Date(), generatedById: admin.id, publishedAt: new Date(), publishedById: admin.id,
      entryCount: schedule.entries.length,
      validationSummary: { stats: schedule.stats, diagnostics: schedule.diagnostics.slice(0, 50) } as unknown as Prisma.InputJsonValue,
    },
  });
  if (schedule.entries.length) {
    await prisma.timetableEntry.createMany({
      data: schedule.entries.map((entry) => ({
        versionId: version.id, schoolId: school.id, classId: entry.classId, learningAreaId: entry.learningAreaId,
        teacherId: entry.teacherId, teacherAssignmentId: assignmentIds.get(`${entry.classId}|${entry.learningAreaId}`) ?? null,
        periodId: entry.periodId, dayOfWeek: entry.dayOfWeek, sequence: entry.sequence, roomId: entry.roomId,
        isDoubleLesson: entry.isDoubleLesson, doubleLessonGroupId: entry.doubleLessonGroupId, createdById: admin.id,
      })),
    });
  }
  await prisma.timetable.update({ where: { id: timetable.id }, data: { currentVersionId: version.id, status: 'PUBLISHED', publishedAt: new Date() } });

  const validation = validateTimetable({
    entries: schedule.entries.map((e, index) => ({
      id: `seed-${index}`, classId: e.classId, className: classes.find((c) => c.id === e.classId)?.name,
      learningAreaId: e.learningAreaId, learningAreaName: requirements.find((r) => r.learningAreaId === e.learningAreaId)?.learningArea.name,
      teacherId: e.teacherId, teacherName: teacherRows.find((t) => t.id === e.teacherId)?.user.fullName ?? null,
      periodId: e.periodId, dayOfWeek: e.dayOfWeek, sequence: e.sequence, roomId: e.roomId,
    })),
    periods: periodRows.map((p) => ({ id: p.id, dayOfWeek: p.dayOfWeek, sequence: p.sequence, label: p.label, startTime: p.startTime, endTime: p.endTime, isTeaching: p.isTeaching, isBreak: p.isBreak, isLunch: p.isLunch })),
    workingDays: school.workingDays,
    requirements: requirements.map((r) => ({ classId: r.classId, learningAreaId: r.learningAreaId, periodsPerWeek: r.periodsPerWeek })),
    teachers: teacherRows.map((t) => ({
      id: t.id, name: t.user.fullName, maxPeriodsPerDay: t.maxPeriodsPerDay, maxPeriodsPerWeek: t.maxPeriodsPerWeek,
      unavailable: t.availability.filter((a) => !a.isAvailable).map((a) => ({ dayOfWeek: a.dayOfWeek, periodIndex: a.periodIndex })),
    })),
    assignments: assignmentRows.map((a) => ({ classId: a.classId, learningAreaId: a.learningAreaId, teacherId: a.teacherId })),
    rooms: roomRows.map((r) => ({ id: r.id, name: r.name, capacity: r.capacity })),
  });
  if (validation.conflicts.length) {
    await prisma.timetableConflict.createMany({
      data: validation.conflicts.map((conflict) => ({
        versionId: version.id, schoolId: school.id, severity: conflict.severity, code: conflict.code,
        message: conflict.message, suggestion: conflict.suggestion ?? null,
        classId: conflict.classId ?? null, teacherId: conflict.teacherId ?? null, roomId: conflict.roomId ?? null,
        periodId: conflict.periodId ?? null, entryId: null, dayOfWeek: conflict.dayOfWeek ?? null, sequence: conflict.sequence ?? null,
        metadata: (conflict.metadata ?? undefined) as Prisma.InputJsonValue | undefined,
      })),
    });
  }
  await prisma.timetableGenerationJob.create({
    data: {
      schoolId: school.id, timetableId: timetable.id, requestedById: admin.id, status: 'COMPLETED',
      params: { classes: classes.length, config: generatorConfig } as unknown as Prisma.InputJsonValue,
      diagnostics: schedule.diagnostics as unknown as Prisma.InputJsonValue,
      stats: schedule.stats as unknown as Prisma.InputJsonValue,
      startedAt: new Date(Date.now() - 9000), finishedAt: new Date(),
    },
  });
  log(`Timetable: ${schedule.entries.length} lessons placed, ${schedule.diagnostics.length} diagnostics, ${validation.conflicts.length} conflicts (errors: ${validation.summary.errors})`);

  /* --------------------------- 13. notifications -------------------------- */
  const teacherUserIds = teacherUsers.map((t) => t.id);
  const parentUserIds = parents.map((p) => p.userId);
  await prisma.notification.createMany({
    data: [
      ...teacherUserIds.map((userId) => ({
        schoolId: school.id, userId, type: 'TIMETABLE_PUBLISHED' as const,
        title: 'Term 3 timetable published',
        body: 'The Term 3 2026 whole-school timetable has been published. Open “My timetable” to see your lessons.',
        link: '/teacher/timetable', entityType: 'TimetableVersion', entityId: version.id,
      })),
      ...parentUserIds.map((userId) => ({
        schoolId: school.id, userId, type: 'TIMETABLE_PUBLISHED' as const,
        title: 'Your child’s class timetable is available',
        body: 'The Term 3 2026 class timetable has been published. Open your child’s timetable to see their week.',
        link: '/parent/timetable', entityType: 'TimetableVersion', entityId: version.id,
      })),
      ...parentUserIds.map((userId) => ({
        schoolId: school.id, userId, type: 'NEW_ASSIGNMENT' as const,
        title: 'New assignment set',
        body: 'A new assignment has been set for your child’s class. See the details in Learning resources.',
        link: '/parent/resources', entityType: 'Assignment', entityId: null,
      })),
      {
        schoolId: school.id, userId: admin.id, type: 'SCHOOL_ANNOUNCEMENT' as const,
        title: 'Welcome to EduTrack Pro',
        body: 'This is a seeded demonstration school. Review the setup checklist on your dashboard, then explore the timetable workspace.',
        link: '/admin/dashboard', entityType: 'School', entityId: school.id,
      },
      ...teacherUserIds.slice(0, 3).map((userId) => ({
        schoolId: school.id, userId, type: 'ASSESSMENT_PUBLISHED' as const,
        title: 'Assessment published to guardians',
        body: 'Results for the mathematics CAT are now visible to verified guardians of the class.',
        link: '/teacher/assessments', entityType: 'Assessment', entityId: null,
      })),
    ],
  });
  log(`Notifications: created for ${teacherUserIds.length} teachers and ${parentUserIds.length} parents`);

  /* ----------------------------- 14. audit log ---------------------------- */
  await prisma.auditLog.createMany({
    data: [
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'school.created', entityType: 'School', entityId: school.id, summary: 'Demo school created by prisma/seed.ts' },
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'learningArea.bulkImported', entityType: 'LearningArea', entityId: null, summary: `${LEARNING_AREAS.length} learning areas configured` },
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'timetable.generated', entityType: 'TimetableVersion', entityId: version.id, summary: `${schedule.entries.length} lessons placed by the scheduling engine` },
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'timetable.validated', entityType: 'TimetableVersion', entityId: version.id, summary: `Validation: ${validation.summary.errors} errors, ${validation.summary.warnings} warnings` },
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'timetable.published', entityType: 'TimetableVersion', entityId: version.id, summary: 'Published version 1 for Term 3 2026' },
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'assessment.published', entityType: 'Assessment', entityId: null, summary: `${publishedAssessments.length} assessments published with results` },
      { schoolId: school.id, actorUserId: admin.id, actorRole: 'ADMIN', action: 'parentLink.verified', entityType: 'ParentLearnerLink', entityId: null, summary: `${linkCount} parent–learner links verified` },
    ],
  });

  /* ------------------------------- 15. report ---------------------------- */
  const totalLearners = await prisma.learner.count({ where: { schoolId: school.id } });
  process.stdout.write('\nSeed complete\n-------------\n');
  log(`School          : ${school.name} (${SCHOOL_CODE})`);
  log(`Learners        : ${totalLearners}`);
  log(`Assessments     : ${assessmentCount} · results ${resultCount}`);
  log(`Timetable       : v1 published, ${schedule.entries.length} lessons, ${schedule.stats.lessonsUnplaced} unplaced`);
  process.stdout.write('\nSign in at http://localhost:3000/login\n');
  process.stdout.write(`  ADMIN   ${adminEmail}\n`);
  process.stdout.write(`  TEACHER ${primaryTeacherEmail}\n`);
  process.stdout.write(`  PARENT  ${parentEmail}\n`);
  if (generatedPasswords.admin || generatedPasswords.teacher || generatedPasswords.parent) {
    process.stdout.write('\nPasswords (generated for this run — shown once, never stored in the repo):\n');
    if (generatedPasswords.admin) process.stdout.write(`  ADMIN   ${adminPassword}\n`);
    if (generatedPasswords.teacher) process.stdout.write(`  TEACHER ${staffPassword}\n  (all seeded teachers share this password)\n`);
    if (generatedPasswords.parent) process.stdout.write(`  PARENT  ${parentPassword}\n  (all seeded parents share this password)\n`);
    process.stdout.write('\nSet SEED_ADMIN_PASSWORD / SEED_TEACHER_PASSWORD / SEED_PARENT_PASSWORD to choose your own.\n');
  } else {
    process.stdout.write('\nPasswords came from SEED_* environment variables.\n');
  }
  process.stdout.write('\nNote: every name, assessment number and phone number above is synthetic demo data.\n\n');
}

main()
  .catch((error) => {
    process.stderr.write(`\nSeed failed: ${(error as Error).message}\n${(error as Error).stack ?? ''}\n`);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
