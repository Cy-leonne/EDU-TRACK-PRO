/** Argon2id when available, bcrypt otherwise — mirrors the API's PasswordService. */
async function hashPassword(plain: string): Promise<string> {
  try {
    const argon2 = await import('argon2');
    return await argon2.hash(plain, { type: argon2.argon2id, memoryCost: 19456, timeCost: 2, parallelism: 1 });
  } catch {
    const bcrypt = await import('bcrypt');
    return bcrypt.hash(plain, 12);
  }
}

function randomPassword(): string {
  return `Cbe-${randomBytes(9).toString('base64url')}-${randomBytes(3).toString('hex')}!`;
}

/** Deterministic pseudo-random so repeated seeds produce the same demo numbers. */
function makeRng(seed: number): () => number {
  let state = seed >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 0x1_0000_0000;
  };
}

const rng = makeRng(20261012);
const pick = <T,>(items: readonly T[]): T => items[Math.floor(rng() * items.length)] as T;
const between = (min: number, max: number): number => Math.round(min + rng() * (max - min));

/** A minimal, valid single-page PDF used to demo a real (private) file upload. */
function minimalPdf(lines: string[]): Buffer {
  const text = lines
    .map((line, index) => `BT /F1 12 Tf 60 ${760 - index * 18} Td (${line.replace(/[()\\]/g, '')}) Tj ET`)
    .join('\n');
  const objects = [
    '1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n',
    '2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n',
    '3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>\nendobj\n',
    `4 0 obj\n<< /Length ${text.length} >>\nstream\n${text}\nendstream\nendobj\n`,
    '5 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\n',
  ];
  let pdf = '%PDF-1.4\n';
  const offsets: number[] = [];
  for (const object of objects) {
    offsets.push(pdf.length);
    pdf += object;
  }
  const xrefStart = pdf.length;
  pdf += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
  for (const offset of offsets) pdf += `${String(offset).padStart(10, '0')} 00000 n \n`;
  pdf += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xrefStart}\n%%EOF\n`;
  return Buffer.from(pdf, 'latin1');
}

async function storeFile(schoolId: string, purpose: string, name: string, body: Buffer, ownerUserId: string | null) {
  const objectKey = `${schoolId}/${purpose.toLowerCase()}/${new Date().getUTCFullYear()}/${String(new Date().getUTCMonth() + 1).padStart(2, '0')}/${randomUUID()}.pdf`;
  const target = join(STORAGE_ROOT, objectKey);
  await mkdir(dirname(target), { recursive: true });
  await writeFile(target, body);
  return prisma.fileObject.create({
    data: {
      schoolId,
      ownerUserId,
      storageDriver: 'LOCAL',
      objectKey,
      originalName: name,
      mimeType: 'application/pdf',
      detectedMime: 'application/pdf',
      sizeBytes: body.length,
      checksumSha256: createHash('sha256').update(body).digest('hex'),
      purpose,
      scannedClean: null,
      metadata: { seeded: true, note: 'Synthetic demo document generated by prisma/seed.ts' } as Prisma.InputJsonValue,
    },
  });
}

