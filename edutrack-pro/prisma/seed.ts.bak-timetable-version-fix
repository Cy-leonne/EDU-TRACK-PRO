        description: `${area.name} — Junior School learning area (school-configurable weekly periods).`,
      },
    });
    learningAreas.set(area.code, row.id);
    if (STRANDS[area.code]) {
      for (const [order, strand] of (STRANDS[area.code] ?? []).entries()) {
        const strandRow = await prisma.strand.create({ data: { schoolId: school.id, learningAreaId: row.id, name: strand.name, order } });
