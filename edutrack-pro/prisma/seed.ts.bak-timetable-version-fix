    }
  }
  const roomNames = [
    { name: 'Grade 7 Tumaini', code: 'R7A', kind: 'CLASSROOM' as const },
    { name: 'Grade 7 Baraka', code: 'R7B', kind: 'CLASSROOM' as const },
    { name: 'Grade 8 Imani', code: 'R8A', kind: 'CLASSROOM' as const },
    { name: 'Grade 8 Neema', code: 'R8B', kind: 'CLASSROOM' as const },
    { name: 'Grade 9 Amani', code: 'R9A', kind: 'CLASSROOM' as const },
    { name: 'Science Laboratory', code: 'LAB', kind: 'LABORATORY' as const },
    { name: 'Pre-Technical Workshop', code: 'WSH', kind: 'WORKSHOP' as const },
    { name: 'School Field', code: 'FLD', kind: 'FIELD' as const },
  ];
  const rooms = new Map<string, string>();
  for (const room of roomNames) {
    const row = await prisma.room.create({ data: { schoolId: school.id, name: room.name, code: room.code, kind: room.kind, capacity: room.kind === 'CLASSROOM' ? 45 : 60 } });
    rooms.set(room.code, row.id);
  }
  log(`Learning areas: ${LEARNING_AREAS.length} · strands seeded for ${Object.keys(STRANDS).length} areas · rooms: ${roomNames.length}`);

  /* ------------------------------ 4. teachers ---------------------------- */
  const teacherUsers: { id: string; name: string; email: string; planKey: string }[] = [];
  const teacherPlanKeys = Object.keys(TEACHER_PLAN);
  const primaryTeacherEmail = teacherEmail;
  for (const [index, planKey] of teacherPlanKeys.entries()) {
    const first = index % 2 === 0 ? FIRST_NAMES_F[index % FIRST_NAMES_F.length]! : FIRST_NAMES_M[index % FIRST_NAMES_M.length]!;
    const last = SURNAMES[index % SURNAMES.length]!;
    const email = index === 0 ? primaryTeacherEmail : `${first.toLowerCase()}.${last.toLowerCase()}${index}@nhjs.demo`;
    const user = await prisma.user.create({
      data: {
        email, passwordHash: await hashPassword(staffPassword), fullName: `${first} ${last}`,
        phone: `+2547${between(10_000_000, 99_999_999)}`,
        memberships: { create: { schoolId: school.id, role: 'TEACHER', status: 'ACTIVE' } },
      },
    });
    teacherUsers.push({ id: user.id, name: user.fullName, email, planKey });
  }
  const teacherProfiles = new Map<string, string>();
  for (const [index, teacher] of teacherUsers.entries()) {
    const plan = TEACHER_PLAN[teacher.planKey]!;
    const profile = await prisma.teacherProfile.create({
      data: {
        userId: teacher.id, schoolId: school.id, staffNumber: `TSC/${2026}/${String(index + 1).padStart(3, '0')}`,
        tscNumber: String(between(200_000, 899_999)), phone: `+2547${between(10_000_000, 99_999_999)}`,
        specialization: plan.areas.join(', '), qualifications: index % 3 === 0 ? 'B.Ed (Science)' : 'B.Ed (Arts)',
        employmentType: index % 5 === 0 ? 'BOM_EMPLOYED' : 'TSC_EMPLOYED',
        maxPeriodsPerDay: 7, maxPeriodsPerWeek: plan.maxWeek,
        prefersFreeDays: plan.freeDay ? [plan.freeDay] : [],
      },
    });
    teacherProfiles.set(teacher.planKey, profile.id);
    // Availability: mostly available; the "free day" teacher is unavailable after period 5 on that day,
    // and two teachers have a fixed co-curricular block on Thursday afternoon.
    const unavailable: { dayOfWeek: number; periodIndex: number; reason: string }[] = [];
    // periodIndex refers to the period sequence within the day (see the seed's bell grid below).
    if (plan.freeDay) {
      for (const period of [8, 9, 10]) unavailable.push({ dayOfWeek: plan.freeDay, periodIndex: period, reason: 'Protected planning afternoon' });
    }
    if (index === 1 || index === 4) {
      for (const period of [9, 10]) unavailable.push({ dayOfWeek: 4, periodIndex: period, reason: 'Co-curricular duty (Thursday games)' });
    }
    if (unavailable.length) {
      await prisma.teacherAvailability.createMany({
        data: unavailable.map((slot) => ({ schoolId: school.id, teacherId: profile.id, dayOfWeek: slot.dayOfWeek, periodIndex: slot.periodIndex, isAvailable: false, reason: slot.reason })),
      });
    }
