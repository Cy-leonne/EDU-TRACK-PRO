  log(`Administrator: ${admin.email}`);

  /* ------------------- 3. learning areas, strands, rooms ------------------ */
  const learningAreas = new Map<string, string>();
  for (const [index, area] of LEARNING_AREAS.entries()) {
    const row = await prisma.learningArea.create({
      data: {
        schoolId: school.id, code: area.code, name: area.name, shortName: area.shortName, colorHex: area.colorHex,
