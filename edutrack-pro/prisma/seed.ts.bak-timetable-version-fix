  /* --------------------------- 2. administrator -------------------------- */
  const adminPasswordHash = await hashPassword(adminPassword);
  const admin = await prisma.user.create({
    data: {
      email: adminEmail, passwordHash: adminPasswordHash, fullName: 'Grace Wanjiru (Demo Administrator)', phone: '+254700000002',
